<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>StockManagementProject</display-name>

    <!-- Client Controller -->
    <servlet>
        <servlet-name>ClientController</servlet-name>
        <servlet-class>controller.ClientController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ClientController</servlet-name>
        <url-pattern>/clients</url-pattern>
    </servlet-mapping>

    <!-- Produit Controller -->
    <servlet>
        <servlet-name>ProductController</servlet-name>
        <servlet-class>controller.ProductController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProductController</servlet-name>
        <url-pattern>/products</url-pattern>
    </servlet-mapping>

    <!-- Fournisseur Controller -->
    <servlet>
        <servlet-name>FournisseurController</servlet-name>
        <servlet-class>controller.FournisseurController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FournisseurController</servlet-name>
        <url-pattern>/fournisseurs</url-pattern>
    </servlet-mapping>

    <!-- Commande Controller -->
    <servlet>
        <servlet-name>CommandeController</servlet-name>
        <servlet-class>controller.CommandeController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CommandeController</servlet-name>
        <url-pattern>/commandes</url-pattern>
    </servlet-mapping>

    <!-- Accueil (facultatif si tu veux une page d'accueil) -->
    <welcome-file-list>
        <welcome-file>listClients.jsp</welcome-file>
    </welcome-file-list>

</web-app>
